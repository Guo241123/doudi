<template>
	<view class="post" :class="announce ? 'post-announce' : ''">
		<view class="avatar-wrap" @click="onSelect">
			<image v-if="avatar != ''" class="avatar-img" :src="avatar" mode="aspectFill"></image>
			<view v-else class="avatar" :class="announce ? 'avatar-announce' : ''"></view>
		</view>
		<view class="post-main">
			<!-- 正文区（点击进入帖子详情）：昵称/时间 + 内容 + 媒体 + 高赞评论预览 -->
			<view class="tappable" @click="onSelect">
				<view class="post-head">
					<text class="nick" :class="announce ? 'nick-announce' : ''">{{ nickname }}</text>
					<text class="time" :class="announce ? 'time-announce' : ''">{{ time }}</text>
					<text v-if="announce" class="badge">公告</text>
				</view>

				<text class="post-text" :class="announce ? 'text-announce' : ''">{{ content }}</text>

				<video v-if="videoUrl != ''" class="post-video" :src="videoUrl" :controls="true"></video>

				<view v-else-if="shown.length > 0" class="post-imgs">
					<view class="pi" :class="shown.length == 1 ? 'pi-one' : ''" v-for="(img, i) in shown" :key="i">
						<image class="pi-img" :src="img" mode="aspectFill"></image>
						<view v-if="extra > 0 && i == shown.length - 1" class="pi-more">
							<text class="pi-more-text">+{{ extra }}</text>
						</view>
					</view>
				</view>

				<view v-if="hotAuthor != ''" class="hot-comment">
					<view class="hc-avatar"></view>
					<view class="hc-body">
						<text class="hc-text"><text class="hc-name">{{ hotAuthor }}：</text>{{ hotText }}</text>
					</view>
					<view v-if="hotLike > 0" class="hc-like">
						<svg-icon name="heart" :size="22"></svg-icon>
						<text class="hc-like-num">{{ hotLike }}</text>
					</view>
				</view>
			</view>

			<!-- 互动区：仅 SVG 图标（点赞 / 评论 / 举报） -->
			<view class="post-foot" :class="announce ? 'foot-announce' : ''">
				<view class="pact" @click="onLike">
					<svg-icon :name="announce ? 'heart-white' : (liked ? 'heart-filled' : 'heart')" :size="30"></svg-icon>
					<text class="pact-num" :class="announce ? 'pact-num-announce' : ''">{{ likeCount }}</text>
				</view>
				<view class="pact" @click="onComment">
					<svg-icon :name="announce ? 'comment-white' : 'comment'" :size="30"></svg-icon>
					<text class="pact-num" :class="announce ? 'pact-num-announce' : ''">{{ commentCount }}</text>
				</view>
				<text class="pmore" :class="announce ? 'pmore-announce' : ''" @click="onReport">···</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	// 论坛帖子卡片（原型 .post）：普通帖 + 公告帖（黑灰渐变）
	// 底部「点赞 + 评论 + ··· 举报」仅 SVG 图标；点击正文进入详情
	const props = defineProps<{
		nickname : string
		avatar : string
		time : string
		content : string
		images : string[]
		videoUrl : string
		announce : boolean
		liked : boolean
		likeCount : number
		commentCount : number
		hotAuthor : string
		hotText : string
		hotLike : number
	}>()

	const emit = defineEmits<{
		(e : 'like') : void
		(e : 'comment') : void
		(e : 'report') : void
		(e : 'select') : void
	}>()

	// 信息流最多展示 3 张缩略图，多出的以「+N」覆盖在最后一张
	const shown = computed<string[]>(() : string[] => {
		const arr = props.images
		const out : string[] = []
		const n = arr.length < 3 ? arr.length : 3
		for (let i = 0; i < n; i++) {
			out.push(arr[i])
		}
		return out
	})

	const extra = computed<number>(() : number => {
		const n = props.images.length
		return n > 3 ? n - 3 : 0
	})

	function onLike() {
		emit('like')
	}

	function onComment() {
		emit('comment')
	}

	function onReport() {
		emit('report')
	}

	function onSelect() {
		emit('select')
	}
</script>

<style>
	.post {
		flex-direction: row;
		padding: 28rpx 32rpx;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #f6f6f6;
		background-color: #ffffff;
	}

	.post-announce {
		margin: 28rpx 32rpx;
		padding: 32rpx 30rpx;
		border-radius: 28rpx;
		border-bottom-width: 0px;
		background-image: linear-gradient(135deg, #2c2c2c, #767676);
	}

	.avatar-wrap {
		width: 68rpx;
		height: 68rpx;
	}

	.avatar {
		width: 68rpx;
		height: 68rpx;
		border-radius: 34rpx;
		background-color: #eaeaea;
	}

	.avatar-img {
		width: 68rpx;
		height: 68rpx;
		border-radius: 34rpx;
	}

	.avatar-announce {
		background-color: rgba(255, 255, 255, 0.18);
	}

	.post-main {
		flex: 1;
		margin-left: 22rpx;
	}

	.tappable {
		flex-direction: column;
	}

	.post-head {
		flex-direction: row;
		align-items: center;
	}

	.nick {
		font-size: 28rpx;
