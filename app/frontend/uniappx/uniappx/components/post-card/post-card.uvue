		padding-top: 20rpx;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #f6f6f6;
	}

	.foot-announce {
		border-top-color: rgba(255, 255, 255, 0.18);
	}

	.pact {
		flex-direction: row;
		align-items: center;
		margin-right: 52rpx;
	}

	.pact-num {
		font-size: 26rpx;
		font-weight: 500;
		color: #666666;
		margin-left: 8rpx;
	}

	.pact-num-announce {
		color: #ffffff;
	}

	.pmore {
		margin-left: auto;
		font-size: 32rpx;
		font-weight: 700;
		color: #bbbbbb;
	}

	.pmore-announce {
		color: rgba(255, 255, 255, 0.7);
	}
</style>
