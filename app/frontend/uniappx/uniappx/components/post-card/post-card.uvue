		color: #111111;
	}

	.nick-announce {
		color: #ffffff;
	}

	.time {
		font-size: 24rpx;
		color: #b5b5b5;
		margin-left: 14rpx;
	}

	.time-announce {
		color: rgba(255, 255, 255, 0.5);
	}

	.badge {
		font-size: 21rpx;
		font-weight: 700;
		color: #111111;
		background-color: #ffffff;
		border-radius: 8rpx;
		padding: 2rpx 10rpx;
		margin-left: auto;
	}

	.post-text {
		font-size: 29rpx;
		line-height: 51rpx;
		color: #333333;
		margin-top: 14rpx;
	}

	.text-announce {
		font-size: 30rpx;
		color: rgba(255, 255, 255, 0.95);
	}

	.post-video {
		width: 100%;
		height: 380rpx;
		margin-top: 18rpx;
		border-radius: 14rpx;
		background-color: #000000;
	}

	.post-imgs {
		flex-direction: row;
		margin-top: 18rpx;
	}

	.pi {
		width: 200rpx;
		height: 200rpx;
		border-radius: 14rpx;
		margin-right: 10rpx;
		overflow: hidden;
		position: relative;
	}

	.pi-one {
		width: 440rpx;
		height: 320rpx;
	}

	.pi-img {
		width: 100%;
		height: 100%;
		background-color: #f2f2f2;
	}

	.pi-more {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.45);
		align-items: center;
		justify-content: center;
	}

	.pi-more-text {
		font-size: 32rpx;
		color: #ffffff;
	}

	.hot-comment {
		flex-direction: row;
		align-items: center;
		margin-top: 18rpx;
		background-color: #fcfcfc;
		border-width: 1px;
		border-style: solid;
		border-color: #f4f4f4;
		border-radius: 16rpx;
		padding: 12rpx 18rpx;
	}

	.hc-avatar {
		width: 30rpx;
		height: 30rpx;
		border-radius: 15rpx;
		background-color: #ececec;
	}

	.hc-body {
		flex: 1;
		margin-left: 14rpx;
	}

	.hc-text {
		font-size: 22rpx;
		color: #a8a8a8;
		lines: 1;
		text-overflow: ellipsis;
	}

	.hc-name {
		font-size: 22rpx;
