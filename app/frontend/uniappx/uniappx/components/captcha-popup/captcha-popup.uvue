		font-size: 34rpx;
		font-weight: 700;
		color: #111111;
	}

	.pop-sub {
		font-size: 24rpx;
		color: #aaaaaa;
		margin-top: 12rpx;
	}

	.cap-row {
		flex-direction: row;
		align-items: center;
		margin-top: 36rpx;
	}

	.cap-input {
		flex: 1;
		height: 84rpx;
		font-size: 30rpx;
		color: #111111;
		border-width: 1px;
		border-style: solid;
		border-color: #ededed;
		border-radius: 12rpx;
		padding: 0 20rpx;
	}

	.ph {
		color: #c2c2c2;
		font-size: 28rpx;
	}

	.cap-img {
		width: 220rpx;
		height: 84rpx;
		margin-left: 20rpx;
		border-width: 1px;
		border-style: solid;
		border-color: #ededed;
		border-radius: 12rpx;
		background-color: #f7f7f7;
		align-items: center;
		justify-content: center;
	}

	.cap-image {
		width: 200rpx;
		height: 70rpx;
	}

	.cap-holder {
		font-size: 24rpx;
		color: #b5b5b5;
	}

	.pop-btns {
		flex-direction: row;
		margin-top: 40rpx;
	}

	.pop-btn {
		flex: 1;
		height: 84rpx;
		border-radius: 16rpx;
		align-items: center;
		justify-content: center;
		border-width: 1px;
		border-style: solid;
		border-color: #ededed;
	}

	.pop-btn-dark {
		background-color: #111111;
		border-color: #111111;
		margin-left: 20rpx;
	}

	.pop-btn-text {
		font-size: 30rpx;
		color: #666666;
	}

	.pop-btn-text-dark {
		font-size: 30rpx;
		font-weight: 600;
		color: #ffffff;
	}
</style>
