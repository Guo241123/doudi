<template>
	<view class="page">
		<nav-bar :title="navTitle" :show-back="true" right-text="···" @right="onMore"></nav-bar>

		<view class="chat-head">
			<view class="avatar">
				<image v-if="peerAvatar != ''" class="avatar-img" :src="peerAvatar" mode="aspectFill"></image>
				<text v-else class="avatar-text">{{ peerInitial }}</text>
			</view>
			<view class="who">
				<text class="who-name">{{ peerName }}</text>
				<text class="who-sub">{{ peerSub }}</text>
			</view>
			<view class="role"><text class="role-text">{{ roleText }}</text></view>
		</view>

		<scroll-view class="chat" :scroll-y="true" :scroll-into-view="scrollTo">
			<view v-if="loading && messages.length == 0" class="chat-state">
				<text class="chat-state-text">加载中…</text>
			</view>
			<view v-else-if="failed && messages.length == 0" class="chat-state" @click="loadLatest()">
				<text class="chat-state-text">加载失败，点击重试</text>
			</view>
			<view v-else-if="messages.length == 0" class="chat-state">
				<text class="chat-state-text">还没有消息，打个招呼吧</text>
			</view>
			<view v-else>
				<text v-if="hasMore" class="chat-more" @click="loadOlder()">查看更早的消息</text>
				<view class="bubble-row" :class="m.mine ? 'me' : ''" v-for="(m, i) in messages" :key="m.id">
					<view class="bubble" :class="m.mine ? 'mine' : 'other'">
						<text class="bubble-text" :class="m.mine ? 'bubble-text-mine' : ''">{{ m.text }}</text>
					</view>
					<text class="bubble-time">{{ m.timeText }}</text>
				</view>
			</view>

			<text class="chat-time">{{ footNote }}</text>

			<view v-if="isCustomer" class="quick-links">
				<text class="pill" @click="onCopy('微信')">微信</text>
				<text class="pill" @click="onCopy('QQ')">QQ</text>
				<text class="pill" @click="onCall">电话</text>
			</view>

			<view id="chat-bottom"></view>
		</scroll-view>

		<view class="inputbar">
			<input class="fake-input" placeholder="输入消息…" placeholder-class="ph" v-model="draft" />
			<text class="send" :class="sending ? 'send-off' : ''" @click="onSend">发送</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	// 会话页（原型 11 任务对接 / 18 客服）：接《接口文档》#38 会话内消息、#39 发送消息
	// 轮询节奏：本页停留 5s 拉一次增量；onHide/onUnload 停止
	import { onLoad, onShow, onHide, onUnload } from '@dcloudio/uni-app'
	import { getConversations, getMessages, sendMessage } from '../../api/message.uts'
	import { blacklistUser } from '../../api/report.uts'
	import { errorMessage } from '../../api/request.uts'
	import { getUser } from '../../utils/token.uts'

	type Msg = {
		id : number
		mine : boolean
		text : string
		timeText : string
	}



	/** 自己的用户 id：判断气泡左右（登录时存本地，见 utils/token.uts） */
	/** 从会话列表带过来的对方昵称（列表页已知，省一次请求） */





















	const POLL_MS = 5000

	const PAGE_SIZE = 20

	const conversationId = ref(0)

	const type = ref('CUSTOMER')

	const draft = ref('')

	const scrollTo = ref('')

	const sending = ref(false)

	const loading = ref(true)

	const failed = ref(false)

	const hasMore = ref(false)

	const messages = ref<Msg[]>([])

	const peerUserId = ref(0)

	const peerName = ref('')

	const peerAvatar = ref('')

	const myUserId = ref(0)

	const passedTitle = ref('')

	let timer : number = -1

	const isCustomer = computed<boolean>(() : boolean => {
		return type.value == 'CUSTOMER'
	})

	function typeLabel(t : string) : string {
		if (t == 'TASK_CONSULT') {
			return '任务负责人'
		}
		if (t == 'TRADE') {
			return '卖家'
		}
		return '平台客服'
	}

	const navTitle = computed<string>(() : string => {
		return peerName.value != '' ? peerName.value : typeLabel(type.value)
	})

	const peerInitial = computed<string>(() : string => {
		const n = peerName.value
		return n.length > 0 ? n.substring(0, 1) : '消'
	})

	const peerSub = computed<string>(() : string => {
		if (type.value == 'TASK_CONSULT') {
			return '社区服务中心 · 该任务负责人'
		}
		if (type.value == 'TRADE') {
			return '二手交易 · 与卖家沟通'
		}
		return '工作时间 9:00–18:00'
	})

	const roleText = computed<string>(() : string => {
		if (type.value == 'TASK_CONSULT') {
			return '任务对接'
		}
		if (type.value == 'TRADE') {
			return '联系卖家'
		}
		return '客服'
	})

	const footNote = computed<string>(() : string => {
		if (type.value == 'CUSTOMER') {
			return '也可通过第三方方式联系客服'
		}
		if (type.value == 'TASK_CONSULT') {
			return '此对话仅对接该任务，与平台客服无关'
		}
		return '交易请当面验货，切勿提前汇款'
	})















	// ---- 纯函数 ----


	/** "2026-10-10 20:15:03" → "20:15"；跨天则显示日期 */
	function shortTime(raw : string) : string {
		if (raw.length >= 16) {
			return raw.substring(11, 16)
		}
		return raw
	}

	function parseMessage(o : UTSJSONObject) : Msg {
		return {
			id: o.getNumber('messageId') ?? 0,
			mine: (o.getNumber('senderId') ?? 0) == myUserId.value,
			text: o.getString('content') ?? '',
			timeText: shortTime(o.getString('createTime') ?? '')
		}
	}

	function scrollToBottom() {
		scrollTo.value = ''
		setTimeout(() => {
			scrollTo.value = 'chat-bottom'
		}, 50)
	}

	// ---- 数据加载 ----

	/** 拉最新一页（cursor=0），把比本地更新的消息追加到末尾 */
	function loadLatest() {
		if (conversationId.value <= 0) {
			loading.value = false
			failed.value = true
			return
		}
		const first = messages.value.length == 0
		if (first) {
			loading.value = true
			failed.value = false
		}
		getMessages(conversationId.value, 0, PAGE_SIZE).then((data) => {
			loading.value = false
			const o = data as UTSJSONObject | null
			if (o == null) {
				failed.value = true
				return
			}
			const arr = o.getArray<UTSJSONObject>('list')
			if (arr == null || arr.length == 0) {
				hasMore.value = false
				return
			}
			// 接口按 id 倒序返回，先转成时间正序
			const batch : Msg[] = []
			for (let i = arr.length - 1; i >= 0; i--) {
				batch.push(parseMessage(arr[i]))
			}
			if (first) {
				messages.value = batch
				hasMore.value = o.getBoolean('hasMore') ?? false
				scrollToBottom()
				return
			}
			let lastId = 0
			if (messages.value.length > 0) {
				lastId = messages.value[messages.value.length - 1].id
			}
			let appended = false
			for (let i = 0; i < batch.length; i++) {
				if (batch[i].id > lastId) {
					const item = batch[i]
					messages.value.push(item)
					appended = true
				}
			}
			if (appended) {
				scrollToBottom()
			}
		}).catch((_) => {
			loading.value = false
			if (first) {
				failed.value = true
			}
		})
	}

	/** 上拉更早：cursor 取本地最早一条的 id */
	function loadOlder() {
		if (conversationId.value <= 0 || messages.value.length == 0) {
			return
		}
		const oldest = messages.value[0].id
		loading.value = true
		getMessages(conversationId.value, oldest, PAGE_SIZE).then((data) => {
			loading.value = false
			const o = data as UTSJSONObject | null
			if (o == null) {
				return
			}
			const arr = o.getArray<UTSJSONObject>('list')
			if (arr == null || arr.length == 0) {
				hasMore.value = false
				return
			}
			const older : Msg[] = []
			for (let i = arr.length - 1; i >= 0; i--) {
				older.push(parseMessage(arr[i]))
			}
			const merged : Msg[] = older
			for (let i = 0; i < messages.value.length; i++) {
				merged.push(messages.value[i])
			}
			messages.value = merged
			hasMore.value = o.getBoolean('hasMore') ?? false
		}).catch((_) => {
			loading.value = false
		})
	}

	/** 从会话列表里找出本会话，取真实对方昵称/头像/用户 id */
	function resolvePeer() {
		if (passedTitle.value != '') {
			peerName.value = passedTitle.value
		}
		getConversations(type.value, 0, 50).then((data) => {
			const o = data as UTSJSONObject | null
			if (o == null) {
				return
			}
			const arr = o.getArray<UTSJSONObject>('list')
			if (arr == null) {
				return
			}
			for (let i = 0; i < arr.length; i++) {
				const c = arr[i]
				if ((c.getNumber('conversationId') ?? 0) != conversationId.value) {
					continue
				}
				const peer = c.getJSON('peer')
				if (peer != null) {
					peerUserId.value = peer.getNumber('userId') ?? 0
					const nick = peer.getString('nickname') ?? ''
					if (nick != '') {
						peerName.value = nick
					}
					peerAvatar.value = peer.getString('avatarUrl') ?? ''
				}
				break
			}
			if (peerName.value == '') {
				peerName.value = typeLabel(type.value)
			}
		}).catch((_) => {
			if (peerName.value == '') {
				peerName.value = typeLabel(type.value)
			}
		})
	}

	function stopPoll() {
		if (timer != -1) {
			clearInterval(timer)
			timer = -1
		}
	}

	function startPoll() {
		stopPoll()
		timer = setInterval(() => {
			loadLatest()
		}, POLL_MS)
	}


	// ---- 交互 ----

	function onSend() {
		const text = draft.value.trim()
		if (text == '' || sending.value) {
			return
		}
		if (conversationId.value <= 0) {
			uni.showToast({ title: '会话不存在', icon: 'none' })
			return
		}
		sending.value = true
		sendMessage(conversationId.value, text).then((data) => {
			sending.value = false
			draft.value = ''
			const o = data as UTSJSONObject | null
			const item : Msg = {
				id: o == null ? 0 : (o.getNumber('messageId') ?? 0),
				mine: true,
				text: text,
				timeText: o == null ? '' : shortTime(o.getString('createTime') ?? '')
			}
			messages.value.push(item)
			scrollToBottom()
		}).catch((e) => {
			sending.value = false
			uni.showToast({ title: errorMessage(e), icon: 'none' })
		})
	}

	function onReport() {
		if (peerUserId.value <= 0) {
			uni.showToast({ title: '暂无法获取对方信息', icon: 'none' })
			return
		}
		uni.navigateTo({ url: '/pages/forum/report?targetType=USER&targetId=' + peerUserId.value })
	}

	function onBlacklist() {
		if (peerUserId.value <= 0) {
			uni.showToast({ title: '暂无法获取对方信息', icon: 'none' })
			return
		}
		uni.showModal({
			title: '拉黑用户',
			content: '拉黑后双方将无法互相评论、发消息，可在「设置-黑名单」解除。',
			success: (res) => {
				if (!res.confirm) {
					return
				}
				blacklistUser(peerUserId.value).then((_) => {
					uni.showToast({ title: '已拉黑', icon: 'none' })
					setTimeout(() => {
						uni.navigateBack()
					}, 800)
				}).catch((e) => {
					uni.showToast({ title: errorMessage(e), icon: 'none' })
				})
			}
		})
	}

	function onMore() {
		uni.showActionSheet({
			itemList: ['举报该用户', '拉黑该用户'],
			success: (res) => {
				if (res.tapIndex == 0) {
					onReport()
				} else if (res.tapIndex == 1) {
					onBlacklist()
				}
			}
		})
	}



	function onCopy(kind : string) {
		uni.setClipboardData({
			data: kind == '微信' ? 'kefu_shequ' : '800123456',
			success: () => {
				uni.showToast({ title: '已复制', icon: 'none' })
			}
		})
	}

	function onCall() {
		uni.makePhoneCall({ phoneNumber: '4000000000' })
	}

	// ---- 生命周期 ----

	onLoad((query) => {
		const me = getUser()
		if (me != null) {
			myUserId.value = me.getNumber('userId') ?? 0
		}
		const cid = query['conversationId']
		if (cid != null) {
			conversationId.value = parseInt(cid as string, 10)
		}
		const t = query['type']
		if (t != null) {
			type.value = t as string
		}
		const title = query['title']
		if (title != null) {
			// 来源页已用 encodeURIComponent 编码，这里解回来（含中文/特殊字符的昵称）
			const raw = title as string
			try {
				passedTitle.value = decodeURIComponent(raw) ?? raw
			} catch (_) {
				passedTitle.value = raw
			}
		}
		if (peerName.value == '') {
			peerName.value = typeLabel(type.value)
		}
		resolvePeer()
		loadLatest()
	})

	onShow(() => {
		// 从后台/其他页返回：补一次增量并重开轮询
		if (conversationId.value > 0) {
			loadLatest()
			startPoll()
		}
	})

	onHide(() => {
		stopPoll()
	})

	onUnload(() => {
		stopPoll()
	})
</script>

<style>
	.page {
		flex: 1;
		background-color: #ffffff;
	}

	.chat-head {
		flex-direction: row;
		align-items: center;
		padding: 24rpx 32rpx;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #ededed;
	}

	.avatar {
		width: 80rpx;
		height: 80rpx;
		border-radius: 40rpx;
		background-color: #eaeaea;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.avatar-img {
		width: 80rpx;
		height: 80rpx;
	}

	.avatar-text {
		font-size: 30rpx;
		color: #999999;
	}

	.who {
		flex: 1;
		margin-left: 20rpx;
	}

	.who-name {
		font-size: 29rpx;
		font-weight: 600;
		color: #111111;
	}

	.who-sub {
		font-size: 23rpx;
		color: #999999;
		margin-top: 8rpx;
	}

	.role {
		background-color: #f2f2f2;
		border-radius: 8rpx;
		padding: 6rpx 14rpx;
	}

	.role-text {
		font-size: 21rpx;
		color: #666666;
	}

	.chat {
		flex: 1;
		padding: 24rpx 32rpx;
	}

	.chat-state {
		align-items: center;
		justify-content: center;
		padding: 140rpx 0;
	}

	.chat-state-text {
		font-size: 26rpx;
		color: #999999;
	}

	.chat-more {
		font-size: 23rpx;
		color: #999999;
		text-align: center;
		margin-bottom: 20rpx;
	}

	.chat-time {
		font-size: 22rpx;
		color: #bbbbbb;
		text-align: center;
		margin: 16rpx 0;
	}

	.bubble-row {
		flex-direction: column;
		align-items: flex-start;
		margin-bottom: 24rpx;
	}

	.me {
		align-items: flex-end;
	}

	.bubble {
		max-width: 520rpx;
		padding: 20rpx 26rpx;
		border-radius: 20rpx;
	}

	.mine {
		background-color: #111111;
	}

	.other {
		background-color: #f5f5f5;
	}

	.bubble-text {
		font-size: 28rpx;
		line-height: 44rpx;
		color: #222222;
	}

	.bubble-text-mine {
		color: #ffffff;
	}

	.bubble-time {
		font-size: 20rpx;
		color: #c2c2c2;
		margin-top: 8rpx;
	}

	.quick-links {
		flex-direction: row;
		justify-content: center;
		margin-top: 10rpx;
	}

	.pill {
		font-size: 24rpx;
		color: #333333;
		background-color: #f5f5f5;
		border-radius: 999rpx;
		padding: 12rpx 30rpx;
		margin: 0 12rpx;
	}

	.inputbar {
		flex-direction: row;
		align-items: center;
		padding: 18rpx 32rpx;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #ededed;
		background-color: #ffffff;
	}

	.fake-input {
		flex: 1;
		height: 76rpx;
		background-color: #f5f5f5;
		border-radius: 38rpx;
		padding: 0 32rpx;
		font-size: 27rpx;
		color: #111111;
	}

	.ph {
		color: #c2c2c2;
		font-size: 27rpx;
	}

	.send {
		font-size: 28rpx;
		font-weight: 600;
		color: #111111;
		margin-left: 24rpx;
	}

	.send-off {
		color: #cccccc;
	}
</style>
