<template>
	<view class="page">
		<nav-bar :title="editId > 0 ? '编辑二手' : '发布二手'" :show-back="true" right-text="提交" @right="onSubmit"></nav-bar>

		<scroll-view class="body" :scroll-y="true">
			<!-- 图片 / 视频：最多 9 张图或 1 个视频（互斥） -->
			<view class="upload-grid">
				<view class="up-cell filled" v-for="(m, i) in images" :key="i">
					<image class="up-img" :src="m.url" mode="aspectFill"></image>
					<view v-if="m.key == ''" class="up-mask"><text class="up-mask-text">上传中</text></view>
					<view class="up-del" @click="removeImage(i)"><text class="up-del-text">×</text></view>
				</view>

				<view class="up-cell filled" v-if="videoUrl != ''">
					<video class="up-img" :src="videoUrl"></video>
					<view v-if="videoKey == ''" class="up-mask"><text class="up-mask-text">上传中</text></view>
					<view class="up-del" @click="removeVideo"><text class="up-del-text">×</text></view>
				</view>

				<view class="up-cell" v-if="videoUrl == '' && images.length < 9" @click="onAdd">
					<text class="up-plus">+</text>
				</view>
			</view>
			<text class="hint">最多 9 张图片或 1 个视频（视频 ≤ 60 秒）</text>

			<view class="frow">
				<text class="frow-label">标题</text>
				<input class="frow-input" placeholder="一句话描述你的物品" placeholder-class="ph" v-model="title" :maxlength="30" />
			</view>
			<view class="frow frow-top">
				<text class="frow-label">描述</text>
				<textarea class="frow-area" placeholder="成色、购买时间、使用情况…" placeholder-class="ph" v-model="desc" :maxlength="500" />
			</view>
			<view class="frow">
				<text class="frow-label">价格</text>
				<input class="frow-input frow-price" type="number" placeholder="0.00" placeholder-class="ph" v-model="price" />
				<text class="frow-val">元</text>
			</view>
			<view class="frow" @click="onPickCategory">
				<text class="frow-label">分类</text>
				<text class="frow-pick">{{ categoryName != '' ? categoryName : '请选择分类' }}</text>
				<text class="frow-arrow">›</text>
			</view>
			<view class="frow">
				<text class="frow-label">联系方式</text>
				<input class="frow-input" placeholder="微信 / QQ / 电话（选填，不公开展示）" placeholder-class="ph" v-model="contact" />
			</view>
			<view class="frow">
				<text class="frow-label">可议价</text>
				<view class="switch" :class="bargain ? 'switch-on' : ''" @click="toggleBargain">
					<view class="knob" :class="bargain ? 'knob-on' : ''"></view>
				</view>
			</view>

			<view class="submit-wrap">
				<view class="btn-dark" :class="submitting ? 'btn-disabled' : ''" @click="onSubmit">
					<text class="btn-dark-text">{{ submitting ? '提交中…' : '提交审核' }}</text>
				</view>
				<text class="hint hint-center">提交后进入审核，24 小时内完成，结果可在「我的发布」查看</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 发布 / 编辑二手（需求 4.2.4，原型 7）
	// 对接《接口文档》#20 发布、#21 编辑、#19 详情（编辑回填）、#26 OSS 直传
	import { onLoad } from '@dcloudio/uni-app'
	import { getCategories, getItemDetail, publishItem, updateItem } from '../../api/trade.uts'
	import { uploadLocalFile } from '../../api/upload.uts'
	import { errorMessage } from '../../api/request.uts'
	import { trackPublish, trackPageView } from '../../utils/analytics.uts'

	type Category = {
		id : number
		name : string
	}

	// 媒体项：url 用于预览（本地临时路径或远端地址），key 为 OSS fileKey
	type Media = {
		url : string
		key : string
	}

	const editId = ref(0)
	const title = ref('')
	const desc = ref('')
	const price = ref('')
	const contact = ref('')
	const bargain = ref(false)

	const images = ref<Media[]>([])
	const videoUrl = ref('')
	const videoKey = ref('')

	const categories = ref<Category[]>([])
	const categoryId = ref(0)
	const categoryName = ref('')

	const uploading = ref(false)
	const submitting = ref(false)

	function fenToYuan(fen : number) : string {
		const yuan = Math.floor(fen / 100)
		const cent = fen % 100
		if (cent == 0) {
			return '' + yuan
		}
		let cs = '' + cent
		if (cent < 10) {
			cs = '0' + cs
		}
		return yuan + '.' + cs
	}

	function loadCategories() {
		getCategories().then((data) => {
			// #17 分类列表:data 直接是数组(不是 {list:[...]} 包装),之前按对象解析导致发布页无分类可选
			const list = data as Array<UTSJSONObject> | null
			const arr : Category[] = []
			if (list != null) {
				for (let i = 0; i < list.length; i++) {
					const it = list[i]
					const c : Category = { id: it.getNumber('id') ?? 0, name: it.getString('name') ?? '' }
					arr.push(c)
				}
			}
			categories.value = arr
		}).catch((_) => {
		})
	}

	function loadDetail() {
		getItemDetail(editId.value).then((data) => {
			const o = data as UTSJSONObject | null
			if (o == null) {
				return
			}
			title.value = o.getString('title') ?? ''
			desc.value = o.getString('description') ?? ''
			price.value = fenToYuan(o.getNumber('priceFen') ?? 0)
			bargain.value = o.getBoolean('bargainable') ?? false
			categoryId.value = o.getNumber('categoryId') ?? 0
			categoryName.value = o.getString('categoryName') ?? ''

			// #19 返回的是图片 URL；编辑回传时原样带回（新上传的为 fileKey）
			const imgs = o.getArray<string>('images')
			const arr : Media[] = []
			if (imgs != null) {
				for (let i = 0; i < imgs.length; i++) {
					const m : Media = { url: imgs[i], key: '' }
					arr.push(m)
				}
			}
			images.value = arr

			const vu = o.getString('videoUrl') ?? ''
			videoUrl.value = vu
			if (vu != '') {
				videoKey.value = vu
			}
		}).catch((_) => {
		})
	}

	onLoad((query) => {
		// #46 埋点：页面浏览
		trackPageView('trade/publish')
		const idv = query['id']
		if (idv != null) {
			editId.value = parseInt(idv as string, 10)
		}
		loadCategories()
		if (editId.value > 0) {
			loadDetail()
		}
	})



	function removeByUrl(localPath : string) {
		const arr : Media[] = []
		for (let i = 0; i < images.value.length; i++) {
			if (images.value[i].url != localPath) {
				arr.push(images.value[i])
			}
		}
		images.value = arr
	}

	function uploadImage(localPath : string) {
		uploading.value = true
		uploadLocalFile(localPath, 'IMAGE', 'ITEM').then((key) => {
			uploading.value = false
			for (let i = 0; i < images.value.length; i++) {
				if (images.value[i].url == localPath) {
					images.value[i].key = key
					break
				}
			}
		}).catch((e) => {
			uploading.value = false
			removeByUrl(localPath)
			uni.showToast({ title: errorMessage(e), icon: 'none' })
		})
	}

	function pickImages() {
		const remain = 9 - images.value.length
		if (remain <= 0) {
			uni.showToast({ title: '最多 9 张图片', icon: 'none' })
			return
		}
		uni.chooseImage({
			count: remain,
			success: (res) => {
				const paths = res.tempFilePaths
				for (let i = 0; i < paths.length; i++) {
					const m : Media = { url: paths[i], key: '' }
					images.value.push(m)
					uploadImage(paths[i])
				}
			}
		})
	}

	function pickVideo() {
		uni.chooseVideo({
			maxDuration: 60,
			success: (res) => {
				const path = res.tempFilePath
				images.value = []
				videoUrl.value = path
				videoKey.value = ''
				uploading.value = true
				uploadLocalFile(path, 'VIDEO', 'ITEM').then((key) => {
					uploading.value = false
					videoKey.value = key
				}).catch((e) => {
					uploading.value = false
					videoUrl.value = ''
					videoKey.value = ''
					uni.showToast({ title: errorMessage(e), icon: 'none' })
				})
			}
		})
	}

	function onAdd() {
		if (videoUrl.value != '') {
			uni.showToast({ title: '图片与视频不可同时上传', icon: 'none' })
			return
		}
		uni.showActionSheet({
			itemList: ['选择图片', '选择视频', '取消'],
			success: (res) => {
				if (res.tapIndex == 0) {
					pickImages()
				} else if (res.tapIndex == 1) {
					pickVideo()
				}
			}
		})
	}




	function removeImage(index : number) {
		const arr : Media[] = []
		for (let i = 0; i < images.value.length; i++) {
			if (i != index) {
				arr.push(images.value[i])
			}
		}
		images.value = arr
	}


	function removeVideo() {
		videoUrl.value = ''
		videoKey.value = ''
	}

	function toggleBargain() {
		bargain.value = !bargain.value
	}

	function onPickCategory() {
		if (categories.value.length == 0) {
			uni.showToast({ title: '分类加载失败，请稍后重试', icon: 'none' })
			return
		}
		const names : string[] = []
		for (let i = 0; i < categories.value.length; i++) {
			names.push(categories.value[i].name)
		}
		uni.showActionSheet({
			itemList: names,
			success: (res) => {
				const c = categories.value[res.tapIndex]
				categoryId.value = c.id
				categoryName.value = c.name
			}
		})
	}

	function onSubmit() {
		if (submitting.value) {
			return
		}
		if (uploading.value) {
			uni.showToast({ title: '文件上传中，请稍候', icon: 'none' })
			return
		}
		if (title.value == '') {
			uni.showToast({ title: '请填写标题', icon: 'none' })
			return
		}
		if (desc.value == '') {
			uni.showToast({ title: '请填写物品介绍', icon: 'none' })
			return
		}
		const fen = Math.round(parseFloat(price.value) * 100)
		if (!(fen > 0)) {
			uni.showToast({ title: '请填写正确价格', icon: 'none' })
			return
		}
		if (categoryId.value <= 0) {
			uni.showToast({ title: '请选择分类', icon: 'none' })
			return
		}

		const hasVideo = videoKey.value != ''
		const keys : string[] = []
		for (let i = 0; i < images.value.length; i++) {
			const m = images.value[i]
			if (m.key != '') {
				keys.push(m.key)
			}
		}
		if (!hasVideo && keys.length == 0) {
			uni.showToast({ title: '请至少上传一张图片或一个视频', icon: 'none' })
			return
		}

		const data = {} as UTSJSONObject
		data['title'] = title.value
		data['description'] = desc.value
		data['priceFen'] = fen
		data['categoryId'] = categoryId.value
		data['contact'] = contact.value
		data['bargainable'] = bargain.value
		if (hasVideo) {
			const empty : string[] = []
			data['images'] = empty
			data['videoKey'] = videoKey.value
		} else {
			data['images'] = keys
		}

		submitting.value = true
		const task : Promise<any> = editId.value > 0 ? updateItem(editId.value, data) : publishItem(data)
		task.then((_) => {
			submitting.value = false
			// #46 埋点：发布成功（编辑不计入）
			if (editId.value <= 0) {
				trackPublish('ITEM')
			}
			uni.showToast({ title: editId.value > 0 ? '已提交修改，重新审核' : '已提交审核', icon: 'none' })
			setTimeout(() => {
				uni.navigateBack()
			}, 800)
		}).catch((e) => {
			submitting.value = false
			uni.showToast({ title: errorMessage(e), icon: 'none' })
		})
	}
</script>

<style>
	.page {
		flex: 1;
		background-color: #ffffff;
	}

	.body {
		flex: 1;
	}

	.upload-grid {
		flex-direction: row;
		flex-wrap: wrap;
		padding: 32rpx 32rpx 0 32rpx;
	}

	.up-cell {
		width: 200rpx;
		height: 200rpx;
		border-radius: 20rpx;
		border-width: 1px;
		border-style: dashed;
		border-color: #dddddd;
		align-items: center;
		justify-content: center;
		margin: 0 18rpx 18rpx 0;
		position: relative;
		overflow: hidden;
	}

	.up-cell.filled {
		background-color: #f2f2f2;
		border-style: solid;
		border-color: #f2f2f2;
	}

	.up-img {
		width: 200rpx;
		height: 200rpx;
	}

	.up-mask {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.4);
		align-items: center;
		justify-content: center;
	}

	.up-mask-text {
		font-size: 24rpx;
		color: #ffffff;
	}

	.up-del {
		position: absolute;
		top: 0;
		right: 0;
		width: 48rpx;
		height: 48rpx;
		background-color: rgba(0, 0, 0, 0.45);
		align-items: center;
		justify-content: center;
	}

	.up-del-text {
		font-size: 34rpx;
		color: #ffffff;
		line-height: 34rpx;
	}

	.up-plus {
		font-size: 52rpx;
		font-weight: 300;
		color: #cccccc;
	}

	.hint {
		font-size: 23rpx;
		line-height: 38rpx;
		color: #aaaaaa;
		padding: 0 32rpx;
	}

	.hint-center {
		text-align: center;
		margin-top: 16rpx;
	}

	.frow {
		flex-direction: row;
		align-items: center;
		padding: 28rpx 32rpx;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #ededed;
	}

	.frow-top {
		align-items: flex-start;
	}

	.frow-label {
		width: 160rpx;
		font-size: 29rpx;
		color: #333333;
	}

	.frow-input {
		flex: 1;
		font-size: 29rpx;
		color: #111111;
	}

	.frow-price {
		max-width: 220rpx;
	}

	.frow-area {
		flex: 1;
		height: 120rpx;
		font-size: 29rpx;
		color: #111111;
	}

	.frow-val {
		font-size: 28rpx;
		color: #999999;
		margin-left: 12rpx;
	}

	.frow-pick {
		flex: 1;
		font-size: 29rpx;
		color: #333333;
	}

	.frow-arrow {
		font-size: 32rpx;
		color: #cccccc;
	}

	.ph {
		color: #c2c2c2;
		font-size: 29rpx;
	}

	.switch {
		width: 84rpx;
		height: 48rpx;
		border-radius: 24rpx;
		background-color: #e5e5e5;
		padding: 4rpx;
		flex-direction: row;
	}

	.switch-on {
		background-color: #111111;
	}

	.knob {
		width: 40rpx;
		height: 40rpx;
		border-radius: 20rpx;
		background-color: #ffffff;
	}

	.knob-on {
		margin-left: auto;
	}

	.submit-wrap {
		padding: 52rpx 32rpx 60rpx 32rpx;
	}

	.btn-dark {
		background-color: #111111;
		border-radius: 20rpx;
		padding: 32rpx;
		align-items: center;
	}

	.btn-disabled {
		background-color: #999999;
	}

	.btn-dark-text {
		font-size: 31rpx;
		font-weight: 600;
		color: #ffffff;
	}
</style>
