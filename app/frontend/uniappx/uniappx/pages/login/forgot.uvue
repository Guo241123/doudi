<template>
	<view class="page">
		<nav-bar title="忘记密码" :show-back="true"></nav-bar>
		<view class="wrap">
			<view class="head">
				<text class="h3">重置登录密码</text>
				<text class="p">验证手机号后设置新密码，重置成功即自动登录</text>
			</view>

			<view class="field">
				<text class="prefix">+86</text>
				<input class="field-input" type="number" placeholder="请输入手机号" placeholder-class="ph" v-model="mobile" :maxlength="11" />
			</view>

			<view class="field">
				<input class="field-input" type="number" placeholder="请输入 6 位验证码" placeholder-class="ph" v-model="smsCode" :maxlength="6" />
				<text class="mini-btn" :class="countdown > 0 ? 'mini-btn-disabled' : ''" @click="onSendSms">{{ smsBtnText }}</text>
			</view>

			<view class="field">
				<input class="field-input" :password="!showPwd" placeholder="请输入新密码（8～20 位，含字母与数字）" placeholder-class="ph" v-model="newPwd" />
				<view class="eye" @click="togglePwd">
					<svg-icon :name="showPwd ? 'eye' : 'eye-off'" :size="40"></svg-icon>
				</view>
			</view>

			<view class="field">
				<input class="field-input" :password="!showPwd2" placeholder="请再次输入新密码" placeholder-class="ph" v-model="newPwd2" />
				<view class="eye" @click="togglePwd2">
					<svg-icon :name="showPwd2 ? 'eye' : 'eye-off'" :size="40"></svg-icon>
				</view>
			</view>

			<view class="btn-dark" :class="submitting ? 'btn-disabled' : ''" @click="onSubmit">
				<text class="btn-dark-text">{{ submitting ? '提交中…' : '重置密码' }}</text>
			</view>

			<text class="tip">重置后原密码立即失效，请使用新密码登录</text>
		</view>

		<captcha-popup v-if="showCaptcha" :image-src="captchaImg" :loading="captchaLoading"
			@confirm="onCaptchaConfirm" @refresh="loadCaptcha" @close="onCaptchaClose"></captcha-popup>
	</view>
</template>

<script setup lang="uts">
	// 忘记密码（需求文档 4.1.2）：短信验证 + 设置新密码，对接《接口文档》#1/#7
	import { onUnload } from '@dcloudio/uni-app'
	import { getCaptcha, sendSms, resetPassword } from '../../api/auth.uts'
	import { errorCode, errorMessage } from '../../api/request.uts'
	import { setToken, setUser } from '../../utils/token.uts'
	import { isMobile, pwdLengthOk, pwdMixOk } from '../../utils/validate.uts'

	const mobile = ref('')
	const smsCode = ref('')
	const newPwd = ref('')
	const newPwd2 = ref('')
	const showPwd = ref(false)
	const showPwd2 = ref(false)
	const submitting = ref(false)
	const countdown = ref(0)

	const showCaptcha = ref(false)
	const captchaImg = ref('')
	const captchaLoading = ref(false)
	const captchaId = ref('')

	let timer : number = -1

	const smsBtnText = computed<string>(() : string => {
		if (countdown.value > 0) {
			return countdown.value.toString() + 's'
		}
		return '获取验证码'
	})

	function stopCountdown() {
		if (timer != -1) {
			clearInterval(timer)
			timer = -1
		}
	}

	onUnload(() => {
		stopCountdown()
	})


	function togglePwd() {
		showPwd.value = !showPwd.value
	}

	function togglePwd2() {
		showPwd2.value = !showPwd2.value
	}

	function startCountdown() {
		stopCountdown()
		countdown.value = 60
		timer = setInterval(() => {
			if (countdown.value <= 1) {
				countdown.value = 0
				stopCountdown()
			} else {
				countdown.value = countdown.value - 1
			}
		}, 1000)
	}

	function loadCaptcha() {
		captchaLoading.value = true
		getCaptcha().then((data) => {
			const obj = data as UTSJSONObject | null
			if (obj == null) {
				captchaLoading.value = false
				uni.showToast({ title: '验证码获取失败', icon: 'none' })
				return
			}
			captchaId.value = obj.getString('captchaId') ?? ''
			const b64 = obj.getString('imageBase64') ?? ''
			if (b64 == '') {
				captchaImg.value = ''
			} else if (b64.startsWith('data:')) {
				captchaImg.value = b64
			} else {
				captchaImg.value = 'data:image/png;base64,' + b64
			}
			captchaLoading.value = false
		}).catch((_) => {
			captchaLoading.value = false
			uni.showToast({ title: '验证码获取失败，请重试', icon: 'none' })
		})
	}

	function openCaptcha() {
		captchaImg.value = ''
		captchaId.value = ''
		showCaptcha.value = true
		loadCaptcha()
	}


	function onCaptchaClose() {
		showCaptcha.value = false
	}

	function goRegisterWithTip(content : string) {
		uni.showModal({
			title: '提示',
			content: content,
			confirmText: '去注册',
			cancelText: '取消',
			success: (r) => {
				if (r.confirm) {
					uni.navigateTo({ url: '/pages/register/mobile' })
				}
			}
		})
	}

	function doSendSms(cid : string, ccode : string) {
		if (cid == '') {
			uni.showToast({ title: '验证码已失效，请重新获取', icon: 'none' })
			return
		}
		uni.showLoading({ title: '发送中', mask: true })
		sendSms(mobile.value, 'RESET', cid, ccode).then((data) => {
			uni.hideLoading()
			const obj = data as UTSJSONObject | null
			const left = obj == null ? -1 : (obj.getNumber('leftToday') ?? -1)
			if (left >= 0) {
				uni.showToast({ title: '验证码已发送，今日还可发送 ' + left.toString() + ' 次', icon: 'none' })
			} else {
				uni.showToast({ title: '验证码已发送', icon: 'none' })
			}
			startCountdown()
		}).catch((e) => {
			uni.hideLoading()
			const code = errorCode(e)
			const msg = errorMessage(e)
			if (code == 40003) {
				uni.showToast({ title: '图形验证码错误，请重新输入', icon: 'none' })
				openCaptcha()
			} else if (code == 40401) {
				goRegisterWithTip('该手机号还未注册，是否前往注册？')
			} else if (code == 42901 || code == 40301) {
				uni.showModal({ title: '无法发送验证码', content: msg, showCancel: false })
			} else {
				uni.showToast({ title: msg, icon: 'none' })
			}
		})
	}

	function onCaptchaConfirm(code : string) {
		showCaptcha.value = false
		doSendSms(captchaId.value, code)
	}

	function onSendSms() {
		if (countdown.value > 0) {
			return
		}
		if (!isMobile(mobile.value)) {
			uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
			return
		}
		openCaptcha()
	}


	function onSubmit() {
		if (submitting.value) {
			return
		}
		if (!isMobile(mobile.value)) {
			uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
			return
		}
		if (smsCode.value.length != 6) {
			uni.showToast({ title: '请输入 6 位验证码', icon: 'none' })
			return
		}
		if (!pwdLengthOk(newPwd.value) || !pwdMixOk(newPwd.value)) {
			uni.showToast({ title: '新密码需 8～20 位且包含字母与数字', icon: 'none' })
			return
		}
		if (newPwd.value != newPwd2.value) {
			uni.showToast({ title: '两次密码不一致', icon: 'none' })
			return
		}
		submitting.value = true
		resetPassword(mobile.value, smsCode.value, newPwd.value, newPwd2.value).then((data) => {
			submitting.value = false
			const obj = data as UTSJSONObject | null
			const token = obj == null ? '' : (obj.getString('token') ?? '')
			if (token == '') {
				uni.showToast({ title: '重置失败，请重试', icon: 'none' })
				return
			}
			setToken(token)
			const user = obj == null ? null : (obj['user'] as UTSJSONObject | null)
			if (user != null) {
				setUser(user)
			}
			uni.showToast({ title: '密码已重置', icon: 'none' })
			uni.switchTab({ url: '/pages/trade/index' })
		}).catch((e) => {
			submitting.value = false
			const code = errorCode(e)
			const msg = errorMessage(e)
			if (code == 40401) {
				goRegisterWithTip('该手机号还未注册，是否前往注册？')
			} else if (code == 40003) {
				uni.showToast({ title: '验证码错误或已过期', icon: 'none' })
			} else if (code == 40301) {
				uni.showModal({ title: '无法重置密码', content: msg, showCancel: false })
			} else {
				uni.showToast({ title: msg, icon: 'none' })
			}
		})
	}

</script>

<style>
	.page {
		flex: 1;
		background-color: #ffffff;
	}

	.wrap {
		flex: 1;
		flex-direction: column;
		padding: 56rpx 60rpx 60rpx 60rpx;
	}

	.head {
		flex-direction: column;
		margin-bottom: 40rpx;
	}

	.h3 {
		font-size: 45rpx;
		font-weight: 700;
		color: #111111;
	}

	.p {
		font-size: 27rpx;
		color: #aaaaaa;
		line-height: 42rpx;
		margin-top: 16rpx;
	}

	.field {
		flex-direction: row;
		align-items: center;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #ededed;
		padding: 33rpx 0;
		margin-top: 14rpx;
	}

	.prefix {
		font-size: 30rpx;
		color: #555555;
		padding-right: 24rpx;
		margin-right: 24rpx;
		border-right-width: 1px;
		border-right-style: solid;
		border-right-color: #ededed;
	}

	.field-input {
		flex: 1;
		font-size: 30rpx;
		color: #111111;
	}

	.ph {
		color: #c2c2c2;
		font-size: 30rpx;
	}

	.eye {
		padding-left: 20rpx;
	}

	.mini-btn {
		font-size: 24rpx;
		color: #111111;
		background-color: #ffffff;
		border-width: 1px;
		border-style: solid;
		border-color: #dddddd;
		border-radius: 12rpx;
		padding: 10rpx 20rpx;
	}

	.mini-btn-disabled {
		color: #c4c4c4;
		border-color: #ececec;
	}

	.btn-dark {
		background-color: #111111;
		border-radius: 22rpx;
		padding: 33rpx;
		align-items: center;
		margin-top: 60rpx;
	}

	.btn-disabled {
		opacity: 0.6;
	}

	.btn-dark-text {
		font-size: 32rpx;
		font-weight: 600;
		color: #ffffff;
	}

	.tip {
		font-size: 24rpx;
		color: #aaaaaa;
		text-align: center;
		margin-top: 28rpx;
	}
</style>
