<template>
	<view class="page">
		<nav-bar title="设置密码"></nav-bar>
		<view class="reg">
			<view class="reg-head">
				<text class="reg-h3">设置登录密码</text>
				<text class="reg-p">用于后续登录与账号安全验证</text>
			</view>

			<step-bar :steps="steps" :current="2"></step-bar>

			<view class="field">
				<input class="field-input" :password="!showPwd" placeholder="请输入密码" placeholder-class="ph" v-model="pwd" />
				<view class="eye" @click="togglePwd">
					<svg-icon :name="showPwd ? 'eye' : 'eye-off'" :size="32"></svg-icon>
				</view>
			</view>
			<view class="field">
				<input class="field-input" :password="!showPwd2" placeholder="请再次输入密码" placeholder-class="ph" v-model="pwd2" />
				<view class="eye" @click="togglePwd2">
					<svg-icon :name="showPwd2 ? 'eye' : 'eye-off'" :size="32"></svg-icon>
				</view>
			</view>

			<view class="pwd-strength">
				<view class="pwd-bars">
					<view class="bar" :class="barClass(0)"></view>
					<view class="bar" :class="barClass(1)"></view>
					<view class="bar" :class="barClass(2)"></view>
				</view>
				<view class="pwd-label">
					<text class="pwd-label-text">密码强度：</text>
					<text class="pwd-label-strong">{{ strengthText }}</text>
				</view>

				<view class="pwd-rules">
					<view class="pwd-rule" :class="rule1 ? 'ok' : ''">
						<view class="ck"><text v-if="rule1" class="ck-tick">✓</text></view>
						<text class="rule-text">长度 8～20 位</text>
					</view>
					<view class="pwd-rule" :class="rule2 ? 'ok' : ''">
						<view class="ck"><text v-if="rule2" class="ck-tick">✓</text></view>
						<text class="rule-text">包含字母与数字</text>
					</view>
					<view class="pwd-rule" :class="rule3 ? 'ok' : ''">
						<view class="ck"><text v-if="rule3" class="ck-tick">✓</text></view>
						<text class="rule-text">建议包含大写字母或符号</text>
					</view>
				</view>
			</view>

			<view class="btn-dark" :class="submitting ? 'btn-disabled' : ''" @click="onNext">
				<text class="btn-dark-text">{{ submitting ? '提交中…' : '下一步' }}</text>
			</view>
			<text class="reg-tip-center">密码用于账号登录，请勿使用与其他平台相同的密码</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	// 注册②（原型 3，需求文档 4.1.1）：设置密码 + 强度条 + 三条规则校验，对接《接口文档》#3
	import { registerPassword } from '../../api/auth.uts'
	import { errorCode, errorMessage } from '../../api/request.uts'
	import { getRegisterToken, clearRegisterToken } from '../../utils/token.uts'
	import { pwdLengthOk, pwdMixOk, pwdStrongOk, pwdStrength } from '../../utils/validate.uts'

	const steps = ref<string[]>(['手机号', '密码', '昵称'])
	const pwd = ref('')
	const pwd2 = ref('')
	const showPwd = ref(false)
	const showPwd2 = ref(false)
	const submitting = ref(false)

	const rule1 = computed<boolean>(() : boolean => {
		return pwdLengthOk(pwd.value)
	})

	const rule2 = computed<boolean>(() : boolean => {
		return pwdMixOk(pwd.value)
	})

	const rule3 = computed<boolean>(() : boolean => {
		return pwdStrongOk(pwd.value)
	})

	const strength = computed<number>(() : number => {
		return pwdStrength(pwd.value)
	})

	const strengthText = computed<string>(() : string => {
		const s = strength.value
		if (s >= 3) {
			return '强'
		}
		if (s == 2) {
			return '中'
		}
		if (s == 1) {
			return '弱'
		}
		return ''
	})

	function barClass(index : number) : string {
		if (index >= strength.value) {
			return ''
		}
		if (strength.value >= 3) {
			return 'on-strong'
		}
		if (strength.value == 2) {
			return 'on-mid'
		}
		return 'on-weak'
	}

	function togglePwd() {
		showPwd.value = !showPwd.value
	}

	function togglePwd2() {
		showPwd2.value = !showPwd2.value
	}

	function onNext() {
		if (submitting.value) {
			return
		}
		if (!rule1.value || !rule2.value) {
			uni.showToast({ title: '密码需 8～20 位且包含字母与数字', icon: 'none' })
			return
		}
		if (pwd.value != pwd2.value) {
			uni.showToast({ title: '两次密码不一致', icon: 'none' })
			return
		}
		const rt = getRegisterToken()
		if (rt == '') {
			uni.showModal({
				title: '提示',
				content: '注册信息已失效，请重新验证手机号',
				showCancel: false,
				success: (_) => {
					uni.navigateBack()
				}
			})
			return
		}
		submitting.value = true
		registerPassword(rt, pwd.value, pwd2.value).then((_) => {
			submitting.value = false
			uni.navigateTo({ url: '/pages/register/nickname' })
		}).catch((e) => {
			submitting.value = false
			const code = errorCode(e)
			const msg = errorMessage(e)
			if (code == 40002) {
				// registerToken 失效：退回第一步重新验证
				clearRegisterToken()
				uni.showModal({
					title: '提示',
					content: '注册信息已失效，请重新验证手机号',
					showCancel: false,
					success: (_) => {
						uni.navigateBack()
					}
				})
			} else {
				uni.showToast({ title: msg, icon: 'none' })
			}
		})
	}
</script>

<style>
	.page {
		flex: 1;
		background-color: #ffffff;
	}

	.reg {
		flex: 1;
		flex-direction: column;
		padding: 70rpx 60rpx 60rpx 60rpx;
	}

	.reg-head {
		flex-direction: column;
		margin-bottom: 60rpx;
	}

	.reg-h3 {
		font-size: 45rpx;
		font-weight: 700;
		color: #111111;
	}

	.reg-p {
		font-size: 27rpx;
		color: #aaaaaa;
		line-height: 42rpx;
		margin-top: 16rpx;
	}

	.field {
		flex-direction: row;
		align-items: center;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #ededed;
		padding: 33rpx 0;
		margin-top: 14rpx;
	}

	.field-input {
		flex: 1;
		font-size: 30rpx;
		color: #111111;
	}

	.ph {
		color: #c2c2c2;
		font-size: 30rpx;
	}

	.eye {
		width: 56rpx;
		height: 56rpx;
		align-items: center;
		justify-content: center;
	}

	.pwd-strength {
		flex-direction: column;
		margin-top: 33rpx;
	}

	.pwd-bars {
		flex-direction: row;
		margin-bottom: 18rpx;
	}

	.bar {
		flex: 1;
		height: 8rpx;
		border-radius: 999rpx;
		background-color: #ececec;
		margin-right: 10rpx;
	}

	.on-weak {
		background-color: #bbbbbb;
	}

	.on-mid {
		background-color: #888888;
	}

	.on-strong {
		background-color: #111111;
	}

	.pwd-label {
		flex-direction: row;
		align-items: center;
	}

	.pwd-label-text {
		font-size: 24rpx;
		color: #a5a5a5;
	}

	.pwd-label-strong {
		font-size: 24rpx;
		font-weight: 600;
		color: #555555;
	}

	.pwd-rules {
		flex-direction: column;
		margin-top: 28rpx;
	}

	.pwd-rule {
		flex-direction: row;
		align-items: center;
		margin-bottom: 16rpx;
	}

	.pwd-rule .ck {
		width: 30rpx;
		height: 30rpx;
		border-radius: 15rpx;
		border-width: 1px;
		border-style: solid;
		border-color: #dddddd;
		align-items: center;
		justify-content: center;
	}

	.pwd-rule.ok .ck {
		background-color: #111111;
		border-color: #111111;
	}

	.ck-tick {
		font-size: 20rpx;
		color: #ffffff;
	}

	.rule-text {
		font-size: 24rpx;
		color: #b0b0b0;
		margin-left: 14rpx;
	}

	.btn-dark {
		background-color: #111111;
		border-radius: 22rpx;
		padding: 33rpx;
		align-items: center;
		margin-top: 60rpx;
	}

	.btn-disabled {
		opacity: 0.6;
	}

	.btn-dark-text {
		font-size: 32rpx;
		font-weight: 600;
		color: #ffffff;
	}

	.reg-tip-center {
		font-size: 26rpx;
		color: #a5a5a5;
		line-height: 44rpx;
		text-align: center;
		margin-top: 24rpx;
	}
</style>
