		line-height: 42rpx;
		margin-top: 16rpx;
	}

	.avatar-picker {
		flex-direction: column;
		align-items: center;
		margin: 14rpx 0 52rpx 0;
	}

	.av {
		width: 178rpx;
		height: 178rpx;
		border-radius: 89rpx;
		background-color: #f2f2f2;
		border-width: 1px;
		border-style: dashed;
		border-color: #d8d8d8;
		align-items: center;
		justify-content: center;
	}

	.av-tip {
		font-size: 24rpx;
		color: #b5b5b5;
		margin-top: 24rpx;
	}

	.field {
		flex-direction: row;
		align-items: center;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #ededed;
		padding: 33rpx 0;
		margin-top: 14rpx;
	}

	.field-input {
		flex: 1;
		font-size: 30rpx;
		color: #111111;
	}

	.ph {
		color: #c2c2c2;
		font-size: 30rpx;
	}

	.nick-count {
		font-size: 22rpx;
		color: #c4c4c4;
		align-self: flex-end;
		padding-bottom: 12rpx;
	}

	.frow {
		flex-direction: row;
		align-items: center;
		padding: 33rpx 0;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #ededed;
	}

	.frow-label {
		font-size: 29rpx;
		color: #666666;
	}

	.frow-value-dark {
		font-size: 29rpx;
		color: #333333;
		margin-left: auto;
		margin-right: 12rpx;
	}

	.btn-dark {
		background-color: #111111;
		border-radius: 22rpx;
		padding: 33rpx;
		align-items: center;
		margin-top: 60rpx;
	}

	.btn-disabled {
		opacity: 0.6;
	}

	.btn-dark-text {
		font-size: 32rpx;
		font-weight: 600;
		color: #ffffff;
	}

	.reg-tip-center {
		font-size: 26rpx;
