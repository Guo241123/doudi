<template>
	<view class="page">
		<nav-bar title="发布帖子" :show-back="true" right-text="发布" @right="onPublish"></nav-bar>

		<scroll-view class="body" :scroll-y="true">
			<view class="compose">
				<textarea class="compose-area" placeholder="分享你的想法…" placeholder-class="ph" v-model="content" :maxlength="1000" />
				<text class="compose-count">{{ content.length }} / 1000</text>
			</view>

			<!-- 图片 / 视频：最多 9 张图或 1 个视频（互斥，与发布二手一致） -->
			<view class="upload-grid">
				<view class="up-cell filled" v-for="(m, i) in images" :key="i">
					<image class="up-img" :src="m.url" mode="aspectFill"></image>
					<view v-if="m.key == ''" class="up-mask"><text class="up-mask-text">上传中</text></view>
					<view class="up-del" @click="removeImage(i)"><text class="up-del-text">×</text></view>
				</view>

				<view class="up-cell filled" v-if="videoUrl != ''">
					<video class="up-img" :src="videoUrl"></video>
					<view v-if="videoKey == ''" class="up-mask"><text class="up-mask-text">上传中</text></view>
					<view class="up-del" @click="removeVideo"><text class="up-del-text">×</text></view>
				</view>

				<view class="up-cell" v-if="videoUrl == '' && images.length < 9" @click="onAdd">
					<text class="up-plus">+</text>
				</view>
			</view>
			<text class="hint">最多 9 张图片或 1 个视频（视频 ≤ 60 秒）</text>

			<view class="submit-wrap">
				<view class="btn-dark" :class="submitting ? 'btn-disabled' : ''" @click="onPublish">
					<text class="btn-dark-text">{{ submitting ? '发布中…' : '发布' }}</text>
				</view>
				<text class="hint hint-center">发布后立即展示，如含违规内容将由管理员事后处理</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 发布帖子（需求 4.4.3，原型 14）：正文（1000 字）+ 图片/视频（≤9 图或 1 视频）
	// 对接《接口文档》#28 发帖（先发后审，命中敏感词返回 40002）、#26 OSS 直传
	import { onLoad } from '@dcloudio/uni-app'
	import { publishPost } from '../../api/forum.uts'
	import { uploadLocalFile } from '../../api/upload.uts'
	import { errorMessage } from '../../api/request.uts'
	import { trackPublish, trackPageView } from '../../utils/analytics.uts'

	// 媒体项：url 用于预览（本地临时路径），key 为 OSS fileKey
	type Media = {
		url : string
		key : string
	}

	const content = ref('')
	const images = ref<Media[]>([])
	const videoUrl = ref('')
	const videoKey = ref('')
	const uploading = ref(false)
	const submitting = ref(false)

	// 注意：UTS 不做函数声明提升，被调用的函数必须定义在调用者之前

	function removeByUrl(localPath : string) {
		const arr : Media[] = []
		for (let i = 0; i < images.value.length; i++) {
			if (images.value[i].url != localPath) {
				arr.push(images.value[i])
			}
		}
		images.value = arr
	}

	function removeImage(index : number) {
		const arr : Media[] = []
		for (let i = 0; i < images.value.length; i++) {
			if (i != index) {
				arr.push(images.value[i])
			}
		}
		images.value = arr
	}

	function uploadImage(localPath : string) {
		uploading.value = true
		uploadLocalFile(localPath, 'IMAGE', 'POST').then((key) => {
			uploading.value = false
			for (let i = 0; i < images.value.length; i++) {
				if (images.value[i].url == localPath) {
					images.value[i].key = key
					break
				}
			}
		}).catch((e) => {
			uploading.value = false
			removeByUrl(localPath)
			uni.showToast({ title: errorMessage(e), icon: 'none' })
		})
	}

	function pickImages() {
		const remain = 9 - images.value.length
		if (remain <= 0) {
			uni.showToast({ title: '最多 9 张图片', icon: 'none' })
			return
		}
		uni.chooseImage({
			count: remain,
			success: (res) => {
				const paths = res.tempFilePaths
				for (let i = 0; i < paths.length; i++) {
					const m : Media = { url: paths[i], key: '' }
					images.value.push(m)
					uploadImage(paths[i])
				}
			}
		})
	}

	function pickVideo() {
		uni.chooseVideo({
			maxDuration: 60,
			success: (res) => {
				const path = res.tempFilePath
				images.value = []
				videoUrl.value = path
				videoKey.value = ''
				uploading.value = true
				uploadLocalFile(path, 'VIDEO', 'POST').then((key) => {
					uploading.value = false
					videoKey.value = key
				}).catch((e) => {
					uploading.value = false
					videoUrl.value = ''
					videoKey.value = ''
					uni.showToast({ title: errorMessage(e), icon: 'none' })
				})
			}
		})
	}

	function removeVideo() {
		videoUrl.value = ''
		videoKey.value = ''
	}

	function onPublish() {
		if (submitting.value) {
			return
		}
		if (uploading.value) {
			uni.showToast({ title: '文件上传中，请稍候', icon: 'none' })
			return
		}
		if (content.value == '') {
			uni.showToast({ title: '请输入内容', icon: 'none' })
			return
		}

		const hasVideo = videoKey.value != ''
		const keys : string[] = []
		for (let i = 0; i < images.value.length; i++) {
			const m = images.value[i]
			if (m.key != '') {
				keys.push(m.key)
			}
		}
		if (!hasVideo && keys.length == 0 && images.value.length > 0) {
			uni.showToast({ title: '图片上传中，请稍候', icon: 'none' })
			return
		}
		// 后端强制"图片与视频至少其一"，本地先拦，别让用户填完整页才吃报错
		if (!hasVideo && keys.length == 0) {
			uni.showToast({ title: '请至少上传一张图片或一个视频', icon: 'none' })
			return
		}

		submitting.value = true
		publishPost(content.value, keys, hasVideo ? videoKey.value : '').then((_) => {
			submitting.value = false
			// #46 埋点：发布成功
			trackPublish('POST')
			uni.showToast({ title: '发布成功', icon: 'none' })
			setTimeout(() => {
				uni.navigateBack()
			}, 800)
		}).catch((e) => {
			submitting.value = false
			uni.showToast({ title: errorMessage(e), icon: 'none' })
		})
	}

	function onAdd() {
		if (videoUrl.value != '') {
			uni.showToast({ title: '图片与视频不可同时上传', icon: 'none' })
			return
		}
		uni.showActionSheet({
			itemList: ['选择图片', '选择视频'],
			success: (res) => {
				if (res.tapIndex == 0) {
					pickImages()
				} else if (res.tapIndex == 1) {
					pickVideo()
				}
			}
		})
	}

	onLoad((_) => {
		// #46 埋点：页面浏览
		trackPageView('forum/publish')
	})
</script>

<style>
	.page {
		flex: 1;
		background-color: #ffffff;
	}

	.body {
		flex: 1;
	}

	.compose {
		padding: 32rpx;
	}

	.compose-area {
		width: 100%;
		height: 240rpx;
		font-size: 30rpx;
		line-height: 48rpx;
		color: #111111;
	}

	.ph {
		color: #c2c2c2;
		font-size: 30rpx;
	}

	.compose-count {
		font-size: 23rpx;
		color: #c2c2c2;
		text-align: right;
		margin-top: 12rpx;
	}

	.upload-grid {
		flex-direction: row;
		flex-wrap: wrap;
		padding: 8rpx 32rpx 0 32rpx;
	}

	.up-cell {
		width: 200rpx;
		height: 200rpx;
		border-radius: 20rpx;
		border-width: 1px;
		border-style: dashed;
		border-color: #dddddd;
		align-items: center;
		justify-content: center;
		margin: 0 18rpx 18rpx 0;
		position: relative;
		overflow: hidden;
	}

	.up-cell.filled {
		background-color: #f2f2f2;
		border-style: solid;
		border-color: #f2f2f2;
	}

	.up-img {
		width: 200rpx;
		height: 200rpx;
	}

	.up-mask {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.4);
		align-items: center;
		justify-content: center;
	}

	.up-mask-text {
		font-size: 24rpx;
		color: #ffffff;
	}

	.up-del {
		position: absolute;
		top: 0;
		right: 0;
		width: 48rpx;
		height: 48rpx;
		background-color: rgba(0, 0, 0, 0.45);
		align-items: center;
		justify-content: center;
	}

	.up-del-text {
		font-size: 34rpx;
		color: #ffffff;
		line-height: 34rpx;
	}

	.up-plus {
		font-size: 52rpx;
		font-weight: 300;
		color: #cccccc;
	}

	.hint {
		font-size: 23rpx;
		line-height: 38rpx;
		color: #aaaaaa;
		padding: 0 32rpx;
	}

	.hint-center {
		text-align: center;
		margin-top: 16rpx;
	}

	.submit-wrap {
		padding: 52rpx 32rpx 60rpx 32rpx;
	}

	.btn-dark {
		background-color: #111111;
		border-radius: 20rpx;
		padding: 32rpx;
		align-items: center;
	}

	.btn-disabled {
		background-color: #999999;
	}

	.btn-dark-text {
		font-size: 31rpx;
		font-weight: 600;
		color: #ffffff;
	}
</style>
